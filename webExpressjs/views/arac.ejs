<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
</head>

<body>
    <%- include("./layouts/navbar.ejs") %>
    <h1>Araçlar</h1>
    <p>
        Marka : <%= markaAdi %>
    </p>
    <p>
        Şehir : <%= sehirAdi %>
    </p>
    <p>
        Max : <%= max %>
    </p>
    <p>
        Min : <%= min %>
    </p>
    <% if(min < 3000) { %>
        <p>Minimum değeri 3000'den küçük olamaz.</p>
    <% } %>
    <% if(min === max) { %>
        <p>Minimum ve Maximum değerileri birbirine eşit olamaz.</p>
    <% } %>
    <% if(min > max) { %>
        <p>Minimum değeri Maximum değerinden büyük olamaz.</p>
    <% } else { %>
        <p>Filtrelemede sorun yok.</p>
    <% } %>
</body>

</html>